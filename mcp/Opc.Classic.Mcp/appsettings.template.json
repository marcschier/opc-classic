      "_documentation": "Sample only. Do not store literal passwords here. Reference environment variables or an external secret store and pass resolved credentials to MCP tools only when needed.",
      "Hosts": {
        "localhost": {
          "Authentication": "DefaultIdentity"
        },
        "plant-historian01": {
          "Authentication": "NtlmV2",
          "Username": "CONTOSO\\opc-reader",
