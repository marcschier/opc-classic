<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TRANSITIONAL: this is COM.Net/SharpInterop.Test, a collection of manual
    integration drivers (most "test" files are `public static void RunTest(string[] args)`
    entry points that require a live DCOM endpoint + credentials). Driver.cs is
    explicitly excluded from compilation in the original.

    Phase 3B adds focused TUnit coverage for hardened DCOM protection defaults.
    Phase 11 later rewrites the remaining manual drivers under siblings such as
    tests/OpcClassic.Dcom.Unit.Tests/ and tests/OpcClassic.Dcom.Integration.Tests/.
  -->

  <PropertyGroup>
    <Description>(Transitional) Legacy SharpInterop integration-driver samples — pending Phase 11 rewrite.</Description>
    <RootNamespace>SharpInterop.Test</RootNamespace>
    <AssemblyName>OpcClassic.Dcom.LegacyTests</AssemblyName>

    <!-- Opt in to TUnit/MTP for focused unit coverage while retaining legacy drivers. -->
    <IsTestProject>true</IsTestProject>

    <!-- TUnit runner plus legacy driver library code. -->
    <OutputType>Exe</OutputType>

    <!-- Relax inherited strictness (same as the moved Dcom project) -->
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Nullable>annotations</Nullable>
    <NoWarn>$(NoWarn);CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8629;CS8765;CS0612;CS0618;CA1031;CA1062;CA2007;CA1305;CA1307;CA1310;CA1822;CA2249;CA1416;IDE0290</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Driver.cs is the broken Java-converter orchestrator; preserved exclusion -->
    <Compile Remove="Tests\Driver.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpcClassic.Dcom\OpcClassic.Dcom.csproj" />
  </ItemGroup>

</Project>
