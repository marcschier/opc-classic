<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TRANSITIONAL: this is COM.Net/SharpInterop.Test, a collection of manual
    integration drivers (every "test" file is a `public static void RunTest(string[] args)`
    that requires a live DCOM endpoint + credentials). It is NOT a real test
    project — Driver.cs is explicitly excluded from compilation in the original.

    Phase 11 rewrites these into real TUnit tests under siblings such as
    tests/OpcClassic.Dcom.Unit.Tests/ and tests/OpcClassic.Dcom.Integration.Tests/.
    Until then, this project compiles as a non-publishable library of legacy
    drivers — it opts out of TUnit/MTP by setting IsTestProject=false.
  -->

  <PropertyGroup>
    <Description>(Transitional) Legacy SharpInterop integration-driver samples — pending Phase 11 rewrite.</Description>
    <RootNamespace>SharpInterop.Test</RootNamespace>
    <AssemblyName>OpcClassic.Dcom.LegacyTests</AssemblyName>

    <!-- Opt out of TUnit/MTP from tests/Directory.Build.props -->
    <IsTestProject>false</IsTestProject>

    <!-- Library — not a test runner -->
    <OutputType>Library</OutputType>

    <!-- Relax inherited strictness (same as the moved Dcom project) -->
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Nullable>annotations</Nullable>
    <NoWarn>$(NoWarn);CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8629;CS8765;CS0612;CS0618;CA1031;CA1062;CA2007;CA1305;CA1307;CA1310;CA1822;CA2249;CA1416;IDE0290</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Driver.cs is the broken Java-converter orchestrator; preserved exclusion -->
    <Compile Remove="Tests\Driver.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpcClassic.Dcom\OpcClassic.Dcom.csproj" />
  </ItemGroup>

</Project>
