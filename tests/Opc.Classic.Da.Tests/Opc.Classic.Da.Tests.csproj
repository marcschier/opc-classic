<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>TUnit-based unit tests for Opc.Classic.Da managed types.</Description>
    <RootNamespace>Opc.Classic.Da.Tests</RootNamespace>
    <AssemblyName>Opc.Classic.Da.Tests</AssemblyName>
    <!-- OpcDaServerCcwTests invokes CCW vtable thunks through function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Opc.Classic.Da\Opc.Classic.Da.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Verify.TUnit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Wire\Fixtures\*.hex" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
