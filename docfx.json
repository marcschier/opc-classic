{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/Opc.Classic.Core/Opc.Classic.Core.csproj",
            "src/Opc.Classic.Da/Opc.Classic.Da.csproj",
            "src/Opc.Classic.Ae/Opc.Classic.Ae.csproj",
            "src/Opc.Classic.Hda/Opc.Classic.Hda.csproj",
            "src/Opc.Classic.Dx/Opc.Classic.Dx.csproj",
            "src/Opc.Classic.Cpx/Opc.Classic.Cpx.csproj",
            "src/Opc.Classic.Batch/Opc.Classic.Batch.csproj",
            "src/Opc.Classic.Commands/Opc.Classic.Commands.csproj",
            "src/Opc.Classic.Security/Opc.Classic.Security.csproj",
            "src/Opc.Classic.Xml/Opc.Classic.Xml.csproj",
            "src/Opc.Classic.Hosting/Opc.Classic.Hosting.csproj",
            "src/Opc.Classic.Discovery/Opc.Classic.Discovery.csproj",
            "src/Opc.Classic.Dcom.Kerberos/Opc.Classic.Dcom.Kerberos.csproj"
          ]
        }
      ],
      "dest": "docs/api",
      "outputFormat": "mref"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "docs/**/*.md",
          "docs/**/toc.yml"
        ]
      }
    ],
    "resource": [],
    "globalMetadata": {
      "_appName": "OPC Classic .NET",
      "_appTitle": "OPC Classic .NET",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/marcschier/opc-classic",
        "branch": "main"
      }
    },
    "dest": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [
      "ExtractSearchIndex"
    ],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false
  }
}
