import "opccomn.idl";
import "opchda.idl";

[
	uuid(6A5EEDED-1509-4627-997F-993CCB65AB7C),
	version(1.0)
]
library OpcHdaServerLib
{
	importlib("stdole32.tlb");
	importlib("stdole2.tlb");
    
	[
		uuid(6A5EEDEC-1509-4627-997F-993CCB65AB7C),
        helpstring("Historical Data Access 1.20 Sample Server")
	]
	coclass OpcHdaServer
	{
		[default] interface IOPCHDA_Server;
        [source]  interface IOPCShutdown;
        [source]  interface IOPCHDA_DataCallback;
	};
};
