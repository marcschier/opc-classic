  "prerequisites": [
    {
      "id": "external-product",
      "description": "Operator supplies, licenses, installs, and registers this external product.",
      "required": true,
      "artifact": {
        "rootToken": "OPC_VENDOR_INSTALL_ROOT",
        "relativePath": "server.exe"
      }
    }
  ],
  "arguments": {
    "da": {
      "browseBranch": "",
      "browseFilter": "all",
      "groupName": "OpcClassicVendorProbe",
      "active": true,
      "updateRateMs": 500,
      "itemIds": [
        "Vendor.Writable"
      ],
      "clientHandles": [
        1
      ],
      "fromCache": false,
      "writeValues": [
        1
      ],
      "maxNotifications": 10
    },
    "ae": {
      "source": "Vendor.Source",
      "condition": "Vendor.Condition",
      "returnedAttributeIds": [
        1,
        2
      ],
      "refreshWaitMs": 1000
    },
    "hda": {
      "itemId": "Vendor.History",
      "startTime": "NOW-1H",
      "endTime": "NOW",
      "atTime": "NOW-5M",
      "aggregateId": 1,
      "resampleIntervalSeconds": 60
    }
  },
