<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TRANSITIONAL: this is the moved SharpInterop codebase as it stood prior to
    Phase 2 modernization. Properties from src/Directory.Build.props (net10,
    nullable, IsAotCompatible=true, TreatWarningsAsErrors=true, AOT analyzers
    as errors) are EXPLICITLY OVERRIDDEN below — they cannot apply to legacy
    Java-converter-style C# that uses reflection, MethodInfo.Invoke, dynamic
    Type dispatch, ThreadGroup, etc.

    Phase 2 progressively re-enables strictness as each file is modernized.
    Tracking: see todos p2a..p2i.
  -->

  <PropertyGroup>
    <Description>Cross-platform pure-managed MSRPC/DCOM stack — successor to SharpInterop (port of j-Interop) modernized for .NET 10 and NativeAOT.</Description>
    <RootNamespace>SharpInterop</RootNamespace>
    <AssemblyName>OpcClassic.Dcom</AssemblyName>
    <PackageId>OpcClassic.Dcom</PackageId>
  </PropertyGroup>

  <!-- TRANSITIONAL: relax inherited strict properties from src/Directory.Build.props -->
  <PropertyGroup>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8619;CS8620;CS8625;CS8629;CS8765;CS8767;CS8770;CS8774;CS8981;CS0612;CS0618;CA1031;CA1062;CA2007;CA1305;CA1307;CA1304;CA1308;CA1310;CA1311;CA1416;CA1822;CA1834;CA1851;CA1854;CA1860;CA1861;CA2008;CA2249;IDE0290;IDE0300;IDE0301;IDE0305;IDE0028;IDE0090;IDE0270;IDE0066</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      TRANSITIONAL package set — Phase 2D replaces SharpCifs.Std (SMBLibrary or
      hand-rolled), Phase 2E hand-rolls MD4+RC4 to eliminate BouncyCastle,
      Phase 2G replaces Serilog with Microsoft.Extensions.Logging abstractions.
    -->
    <PackageReference Include="Portable.BouncyCastle" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="SharpCifs.Std" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Resources\Resource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
