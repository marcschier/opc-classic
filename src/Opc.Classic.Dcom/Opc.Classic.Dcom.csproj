<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Cross-platform pure-managed DCOM client (NTLMv2-secured) for OPC Classic protocols. Replaces the Windows DCOM dependency.</Description>
    <RootNamespace>Opc.Classic.Dcom</RootNamespace>
    <AssemblyName>Opc.Classic.Dcom</AssemblyName>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!--
    AOT + trimming enabled. The Dcom assembly is modernized so that
    reflection on type / dynamic dispatch / MethodInfo.Invoke are absent (the server-dispatch
    source generator replaced them). The remaining transitional relaxations below
    are for nullable-reference annotations (full =enable rewrite is a separate post-1.0
    milestone) and a small set of style warnings that aren't AOT or correctness related.
  -->
  <PropertyGroup>
    <Nullable>annotations</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Suppress nullable-annotation-only warnings (full enable comes post-1.0) -->
    <NoWarn>$(NoWarn);CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8619;CS8620;CS8625;CS8629;CS8765;CS8767;CS8770;CS8774;CS8981;CS0612;CS0618</NoWarn>
    <!-- Suppress IDE style suggestions that conflict with the legacy assembly layout -->
    <NoWarn>$(NoWarn);IDE0290;IDE0300;IDE0301;IDE0305;IDE0028;IDE0090;IDE0270;IDE0066</NoWarn>
    <!-- Globally relaxed in this assembly (legacy code patterns; documented in .editorconfig per-directory) -->
    <NoWarn>$(NoWarn);CA1031;CA1062;CA2007;CA1305;CA1307;CA1304;CA1308;CA1310;CA1311;CA1416;CA1822;CA1834;CA1851;CA1854;CA1860;CA1861;CA2008;CA2249</NoWarn>
  </PropertyGroup>

    <ItemGroup>
        <!--
          The TRANSITIONAL package set is cleared: the legacy SMB shim is replaced by
          self-contained NTLM/NDR compatibility code; BouncyCastle is replaced
          with hand-rolled MD4 + RC4 in Crypto/ plus BCL MD5/HMAC-MD5/DES via the
          transitional Crypto/BcCompat.cs shim; Serilog is removed.
        -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Opc.Classic.Hosting\Opc.Classic.Hosting.csproj" />
        <ProjectReference Include="..\Opc.Classic.Dcom.Kerberos\Opc.Classic.Dcom.Kerberos.csproj" />
        <ProjectReference Include="..\Opc.Classic.Dcom.Smb\Opc.Classic.Dcom.Smb.csproj" />
        <ProjectReference Include="..\Opc.Classic.Generators\Opc.Classic.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Resources\Resource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
