<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Cross-spec primitives for OPC Classic: GUID tables, ResultID/HRESULT wrappers, FILETIME helpers, exception hierarchy, URL parsing, NDR struct helpers. Foundational layer above OpcClassic.Dcom.</Description>
    <RootNamespace>OpcClassic</RootNamespace>
    <AssemblyName>OpcClassic.Core</AssemblyName>
    <PackageId>OpcClassic.Core</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pull in OpcClassic.Generators as an analyzer-mode dependency.
         The generator runs at build time and emits source into this assembly;
         no runtime dependency on the generator assembly is created. -->
    <ProjectReference Include="..\OpcClassic.Generators\OpcClassic.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
