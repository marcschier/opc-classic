# syntax=docker/dockerfile:1

# opc-classic-managed (Linux variant) — managed Opc.Classic.Samples.DaServer
# on `mcr.microsoft.com/dotnet/runtime:10.0-noble-chiseled` for cross-platform
# scenarios that DON'T need Windows COM SCM activation.
#
# This is the preferred container for:
#   - non-Windows DCOM scenarios where the client connects to the managed TCP
#     listener (host:port) instead of going through SCM/CoCreateInstance
#   - CI matrix runs on Linux runners (dramatically cheaper than Windows
#     servercore images)
#   - downstream consumers who want a small, frequently-rebuilt managed image
#
# The Windows variant at `external/docker/opc-managed/Dockerfile` remains the
# right choice when:
#   - actual Windows COM SCM activation via CLSID is required
#   - the matrix MCP client uses CoCreateInstance against a registered
#     DCOM AppID (those paths need windowsservercore)
#
# Multi-arch (linux/amd64, linux/arm64) via docker buildx is wired up in
# .github/workflows/release.yml (docker-publish-linux job).

ARG BUILDPLATFORM=linux/amd64
ARG TARGETPLATFORM=linux/amd64
ARG TARGETARCH=amd64

FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
WORKDIR /src

COPY . .

RUN set -eux; \
    case "$TARGETARCH" in \
        amd64) rid="linux-x64" ;; \
        arm64) rid="linux-arm64" ;; \
        *) echo "Unsupported TARGETARCH=$TARGETARCH. Expected amd64 or arm64." >&2; exit 1 ;; \
    esac; \
    dotnet restore "samples/Opc.Classic.Samples.DaServer/Opc.Classic.Samples.DaServer.csproj" -r "$rid"; \
    dotnet publish "samples/Opc.Classic.Samples.DaServer/Opc.Classic.Samples.DaServer.csproj" \
        -c Release \
        -r "$rid" \
        --self-contained false \
        --no-restore \
        -o /app/publish \
        /p:UseAppHost=false

FROM --platform=$TARGETPLATFORM mcr.microsoft.com/dotnet/runtime:10.0-noble-chiseled AS runtime
WORKDIR /app

LABEL maintainer="Opc.Classic .NET Contributors" \
      org.opencontainers.image.title="Opc.Classic managed OPC DA server (Linux)" \
      org.opencontainers.image.description="Cross-platform .NET 10 managed OPC Classic DA server container (Linux variant)." \
      org.opencontainers.image.source="https://github.com/marcschier/opc-classic" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.authors="Opc.Classic .NET Contributors"

# Default managed-TCP-listener port the sample binds; override via
# OPC_CLASSIC_LISTEN_ADDRESS env var (e.g. "0.0.0.0:51301").
EXPOSE 51300

COPY --from=build --chown=1654:1654 /app/publish ./

USER $APP_UID
ENTRYPOINT ["dotnet", "Opc.Classic.Samples.DaServer.dll"]
