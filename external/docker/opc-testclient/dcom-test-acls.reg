Windows Registry Editor Version 5.00

; -----------------------------------------------------------------------------
; DCOM ACL relaxations for the opc-classic test fleet containers.
;
; SECURITY WARNING: these settings grant anonymous network access to all DCOM
; servers on the machine. They are appropriate for a sandboxed Docker test rig
; only. DO NOT apply on a production host.
;
; Each binary blob below is a SECURITY_DESCRIPTOR encoded per [MS-DTYP] §2.4.6
; that grants COM_RIGHTS_EXECUTE | COM_RIGHTS_EXECUTE_LOCAL | _EXECUTE_REMOTE
; to S-1-1-0 (Everyone) and S-1-5-7 (ANONYMOUS LOGON).
; -----------------------------------------------------------------------------

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Ole]
"EnableDCOM"="Y"
"EnableRemoteConnect"="Y"
"LegacyAuthenticationLevel"=dword:00000001
"LegacyImpersonationLevel"=dword:00000002

; DefaultAccessPermission: grant Everyone + ANONYMOUS LOGON full COM access.
; (binary form of: O:BAG:BAD:(A;;CCDCLCSWRP;;;WD)(A;;CCDCLCSWRP;;;AN) )
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Ole]
"DefaultAccessPermission"=hex:01,00,04,80,64,00,00,00,74,00,00,00,00,00,00,00,\
  14,00,00,00,02,00,50,00,03,00,00,00,00,00,14,00,3f,00,00,00,01,01,00,00,00,\
  00,00,01,00,00,00,00,00,00,18,00,3f,00,00,00,01,02,00,00,00,00,00,05,20,00,\
  00,00,20,02,00,00,00,00,14,00,3f,00,00,00,01,01,00,00,00,00,00,05,07,00,00,\
  00,01,02,00,00,00,00,00,05,20,00,00,00,20,02,00,00,01,02,00,00,00,00,00,05,\
  20,00,00,00,20,02,00,00

; DefaultLaunchPermission: same blob but for class-object launch.
"DefaultLaunchPermission"=hex:01,00,04,80,64,00,00,00,74,00,00,00,00,00,00,00,\
  14,00,00,00,02,00,50,00,03,00,00,00,00,00,14,00,1f,00,00,00,01,01,00,00,00,\
  00,00,01,00,00,00,00,00,00,18,00,1f,00,00,00,01,02,00,00,00,00,00,05,20,00,\
  00,00,20,02,00,00,00,00,14,00,1f,00,00,00,01,01,00,00,00,00,00,05,07,00,00,\
  00,01,02,00,00,00,00,00,05,20,00,00,00,20,02,00,00,01,02,00,00,00,00,00,05,\
  20,00,00,00,20,02,00,00

; Pin the DCOM dynamic port range to 49152-49200 so we can EXPOSE a narrow
; range in the Dockerfile instead of EXPOSE 1-65535. See [MS-RPCE] §3.1.1.5
; for the ncacn_ip_tcp endpoint-allocation algorithm.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Rpc\Internet]
"Ports"=hex(7):34,00,39,00,31,00,35,00,32,00,2d,00,34,00,39,00,32,00,30,00,30,\
  00,00,00,00,00
"PortsInternetAvailable"="Y"
"UseInternetPorts"="Y"

; OPCEnum auto-start so test scripts can browse for registered servers
; without an explicit Start-Service call.
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\OpcEnum]
"Start"=dword:00000002
